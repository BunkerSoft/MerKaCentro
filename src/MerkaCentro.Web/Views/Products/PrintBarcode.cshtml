@model MerkaCentro.Application.DTOs.ProductDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Etiqueta - @Model.Name</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: Arial, sans-serif; background: #f5f5f5; }

        .controls {
            text-align: center;
            padding: 20px;
        }
        .controls button, .controls select, .controls input {
            padding: 8px 16px;
            font-size: 14px;
            margin: 0 4px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }
        .controls button {
            background: #198754;
            color: #fff;
            border: none;
            cursor: pointer;
        }
        .controls button:hover { background: #157347; }
        .controls .btn-back {
            background: #6c757d;
        }

        .labels-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 8px;
            padding: 10px 20px;
        }

        .label {
            border: 1px dashed #ccc;
            background: #fff;
            padding: 8px;
            text-align: center;
            width: 220px;
        }
        .label .product-name {
            font-size: 11px;
            font-weight: bold;
            margin-bottom: 4px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .label .barcode-img {
            width: 180px;
            height: 60px;
        }
        .label .barcode-text {
            font-size: 12px;
            font-family: monospace;
            margin-top: 2px;
        }
        .label .price {
            font-size: 16px;
            font-weight: bold;
            margin-top: 4px;
        }

        @@media print {
            .controls { display: none; }
            body { background: #fff; }
            .labels-container { padding: 0; gap: 2px; }
            .label { border: 1px dashed #ddd; page-break-inside: avoid; }
        }
    </style>
</head>
<body>
    <div class="controls">
        <label>Cantidad de etiquetas:</label>
        <input type="number" id="labelCount" value="1" min="1" max="100" />
        <label>Mostrar precio:</label>
        <select id="showPrice">
            <option value="1">Si</option>
            <option value="0">No</option>
        </select>
        <button onclick="generateLabels()">Generar</button>
        <button onclick="window.print()">Imprimir</button>
        <button class="btn-back" onclick="history.back()">Volver</button>
    </div>

    <div class="labels-container" id="labelsContainer">
    </div>

    <script>
        const product = {
            name: '@Html.Raw(Model.Name.Replace("'", "\\'"))',
            barcode: '@(Model.Barcode ?? Model.Code)',
            price: '@Model.SalePrice.ToString("N2")',
            barcodeImageUrl: '@Url.Action("BarcodeImage", new { id = Model.Id })'
        };

        function generateLabels() {
            const count = parseInt(document.getElementById('labelCount').value) || 1;
            const showPrice = document.getElementById('showPrice').value === '1';
            const container = document.getElementById('labelsContainer');
            container.innerHTML = '';

            for (let i = 0; i < count; i++) {
                const label = document.createElement('div');
                label.className = 'label';
                label.innerHTML = `
                    <div class="product-name">${product.name}</div>
                    <img class="barcode-img" src="${product.barcodeImageUrl}" alt="barcode" />
                    <div class="barcode-text">${product.barcode}</div>
                    ${showPrice ? `<div class="price">$ ${product.price}</div>` : ''}
                `;
                container.appendChild(label);
            }
        }

        generateLabels();
    </script>
</body>
</html>
